tasks {
    run {
        - "zig build run -- -b sdl_renderer {path}"
        opt path=image.png
    }
    supports "zig build run -- --supports"
    format {
        - "zig fmt ."
        - "dprint fmt"
    }
    release "zig build --release=fast"
    clean "rm -rf .zig-cache/ zig-out/"
    count "cloc src"
}
