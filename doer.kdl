tasks {
    show "zig build run"
    show:gpu {
        - "zig build run -- -c config.toml {path}"
        opt path="assets/image.png"
    }
    show:preview "zig build run -- -d preview -c config.toml assets/image.png"
    show:channel "zig build run -- -d gpu -c config.toml assets/channel-test.png"
    show:animation "zig build run -- -d gpu -c config.toml assets/animation-timecode.webp"
    show:diag "zig build run -- -d diag"
    supports "zig build run -- --supports"
    format {
        - "zig fmt ."
        - "dprint fmt"
    }
    release "zig build --release=fast"
    nix.install {
        - "nix profile add ."
        - "nix profile upgrade jve"
    }
    nix.uninstall "nix profile remove jve"
    nix.lock.update "nix flake update"
    nix.zon.update {
        // 自行构建 https://github.com/jcollie/zon2nix 到上一级目录
        - "zon2nix/zig-out/bin/zon2nix --17 --nix=jve/build.zig.zon.nix jve/build.zig.zon"
        cwd "../"
    }
    clean "rm -rf .zig-cache/ zig-out/ zig-pkg/"
    count "cloc src"
}
